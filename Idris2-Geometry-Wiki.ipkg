package Idris2-Geometry-Wiki
version = 0.1.0
authors = "Justin Kelly"
brief   = "Executable Verification Wiki & ScaleTransform Specs for Idris2-Geometry"

depends = Idris2-Geometry, Idris2-Multiset-Core, Idris2-Multiset-Ternary, Idris2-Multiset-Transform, Idris2-Topology, base, idris2-QuickCheck, linear
sourcedir = "Library"

modules = Wiki.ChromoCategorySpec,
          Wiki.Generators,
          Wiki.GeometryMacroAudit,
          Wiki.GeometryScaleTransformSpec,
          Wiki.LatticeStreamSpec,
          Wiki.Main,
          Wiki.SpatialProjectionSpec

main = Wiki.Main
executable = geometry-wiki
