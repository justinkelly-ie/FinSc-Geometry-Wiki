package FinSc-Geometry-Wiki
version = 0.1.0
authors = "Justin Kelly"
brief   = "Executable Verification Wiki & ScaleTransform Specs for FinSc-Geometry"

depends = FinSc-Geometry, FinSc-Multiset-Core, FinSc-Multiset-Ternary, FinSc-Multiset-Transform, FinSc-Topology, base, idris2-QuickCheck, linear
sourcedir = "Library"

modules = Wiki.ChromoCategorySpec,
          Wiki.Generators,
          Wiki.GeometryMacroAudit,
          Wiki.GeometryScaleTransformSpec,
          Wiki.LatticeStreamSpec,
          Wiki.Main,
          Wiki.SpatialProjectionSpec

main = Wiki.Main
executable = geometry-wiki
